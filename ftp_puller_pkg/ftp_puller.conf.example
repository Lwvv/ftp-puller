# ============================================================
# FTP 文件抽取服务 — 配置文件示例
# 部署说明:
#   1. 将本文件复制为 ftp_puller.conf 并填写实际参数;
#   2. 建议权限设为 600 (chmod 600 ftp_puller.conf), 因其中含源端凭据。
# 配置加载优先级: 环境变量 FTP_PULLER_CONF > 本文件 > 交互输入(仅当无配置时回退)
# 各项均为可选; 留空或删除该行即采用默认值(见各条注释)。
# ============================================================

# ---------------- 1. 源服务器(被抽取端) ----------------
# 源端 FTP 服务器地址(示例: 192.168.1.100)
FTP_HOST=192.168.1.100

# 源端 FTP 账户与密码(该账户需具备读权限; 若启用搬家式删除, 另需删权限)
FTP_USER=ftp
FTP_PASS=请填写源服务器FTP密码

# 远端抽取根目录
# 注意(chroot 限制): 若源端 vsftpd 将账户锁定于其家目录, 登录后根路径 "/" 即对应家目录。
#   示例: 账户 ftp 家目录为 /home/ftp 时, 配置 REMOTE_DIR=/   对应抽取 /home/ftp
#                            误配为 /home/ftp 时, 实际路径将变为 /home/ftp/home/ftp
#   故 chroot 环境下配置为 / 即可(仅当源端未启用 chroot 时填写真实绝对路径)。
REMOTE_DIR=/

# ---------------- 2. 本地落盘 ----------------
# 抽取文件存放根目录(须与网闸侧 FTP 账户的家目录保持一致, 示例: /home/ftpadmin)
LOCAL_DIR=/home/ftpadmin

# 跳过在最近 N 秒内发生过修改的文件, 以规避"正在写入/上传"的未完成文件。0 = 不限制
# 默认值 120, 建议 30
MIN_AGE=30

# ---------------- 3. 磁盘监控与自动清理 ----------------
# 监控目标路径所在分区的使用率(填写目录即可, 系统自动取其挂载点)
DISK_PATH=/home

# 当使用率(%)达到该阈值时, 按"修改时间最早优先"的策略删除 LOCAL_DIR 内文件, 直至降至阈值以下
# 设为 0 可关闭自动清理(完全依赖网闸侧删除)
DISK_THRESHOLD=80

# ---------------- 4. 日志 ----------------
# 日志统一存放于 /opt/ftp_puller/logs/ 目录: 当日日志为 ftp_puller_verify.log, 历史日志为 ftp_puller_verify.log.YYYY-MM-DD
# 日志按天轮转, 保留最近 N 天(超出自动删除)。默认值 180; 0 = 永久保留
# 日志中文件大小统一以最小单位"字节"展示, 便于人工核对
LOG_KEEP_DAYS=180

# ---------------- 5. 文件/目录筛选(黑白名单) ----------------
# 默认行为: 全量传输(以下四项均留空)。如需按类型或目录筛选时再填写。
# 匹配优先级: 白名单非空时仅按白名单生效(黑名单忽略); 白名单为空时才应用黑名单。
# 扩展名格式: 逗号分隔, 可带或不带前导点, 系统自动转换为小写; 支持 tar.gz 等复合后缀。

# 文件类型白名单: 仅传输所列扩展名。示例: zip,tar.gz   留空 = 不限制
INCLUDE_EXT=

# 文件类型黑名单: 跳过所列扩展名。示例: tmp,log,part   留空 = 不限制
EXCLUDE_EXT=

# 目录白名单: 仅进入所列子目录(按目录名匹配)。示例: data,backup   留空 = 不限制
INCLUDE_DIRS=

# 目录黑名单: 跳过所列子目录(按目录名匹配)。示例: temp,cache   留空 = 不限制
EXCLUDE_DIRS=

# 是否递归子目录(文件夹传输): 1 = 递归(默认, 一并抽取所有子目录); 0 = 仅抽取 REMOTE_DIR 顶层文件
RECURSE_DIRS=1

# ---------------- 6. 网闸对接(可选) ----------------
# 落盘后是否将文件及子目录属主变更为 LOCAL_DIR 的拥有者(即 ftpadmin), 以便网闸抽走后可删除
# 0 = 否(保持 root 属主, 网闸仅可下载, 无删除权限); 1 = 是
CHOWN_LOCAL=0

# 源端删除策略(搬家式): 1 = 校验通过即尝试删除远端源文件; 若源端 FTP 账户无删除权限, 自动降级为
#   留存模式(源保留、本地已存副本, 仅告警一次, 不刷屏); 0 = 纯留存模式, 永不删除源端文件(适用于
#   源端无删权限、或要求源端留底审计的场景)。无论何种模式, 校验失败的文件均不删除。
DELETE_SOURCE=1

# ---------------- 7. 运行节奏 ----------------
# 每轮抽取之间的等待间隔(秒)。本程序为常驻服务, 间隔到期即进入下一轮抽取,
# 并会在每轮开始时打印一次授权剩余天数。默认值 60; 数值过小会增加源端连接压力。
INTERVAL=60

# ---------------- 8. 授权(使用期限) ----------------
# 授权文件路径。默认值: 程序同级目录下的 license.dat(即部署后 /opt/ftp_puller/license.dat)
# 亦可通过环境变量 LICENSE_FILE 覆盖; 留空则使用默认位置。
# 缺少合法且未过期的 license.dat 时, 程序启动即终止运行(原因见日志)。
# 授权文件由供应商签发并提供, 请将供应商交付的 license.dat 置于上述路径(或与程序同目录)即可。
LICENSE_FILE=

# ============================================================
# FTP 抽取配置示例
# 用法: 复制本文件为 ftp_puller.conf, 填入真实值, 并 chmod 600
# 脚本读取顺序: 环境变量 FTP_PULLER_CONF 指定路径 > ~/.ftp_puller.conf > 交互输入
# ============================================================

# 目标 FTP 服务器 IP 或域名
FTP_HOST=目标服务器IP

# FTP 账号 / 密码(只有读写权限的那个)
FTP_USER=你的FTP账号
FTP_PASS=你的FTP密码

# 远端要抽的根目录(抽取其下所有文件与子目录)
REMOTE_DIR=/remote/source

# 本机(拉取服务器)存放根目录
LOCAL_DIR=/local/dest

# 可选: 跳过 N 秒内修改过的文件, 避开"正在写入"的文件。0=不限制
# MIN_AGE=120
